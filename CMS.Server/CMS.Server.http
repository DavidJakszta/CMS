@CMS.Server_HostAddress = http://localhost:5269
@token = PASTE_TOKEN_HERE
@adminId = 11

### ============================================================
### TOKEN:
###   1. Run the adminLogin request below.
###   2. Copy the "token" value from the JSON response.
###   3. Paste it into the @token variable at the top.
### Tokens expire after 60 minutes - re-run login and re-paste.
### @adminId = the admin user's id (11 in the current DB).
### All requests below with "Authorization: Bearer {{token}}"
### need a valid token.
### ============================================================

# @name adminLogin
POST http://localhost:5269/api/user/login
Content-Type: application/json

{
  "userName": "admin",
  "password": "Admin123!"
}

###

GET {{CMS.Server_HostAddress}}/weatherforecast/
Accept: application/json

###

POST {{CMS.Server_HostAddress}}/api/user/register
Content-Type: application/json

{
  "userName": "testuser1532",
  "email": "test@example.com12",
  "password": "Password123!",
  "displayName": "Test User323"
}

###

POST {{CMS.Server_HostAddress}}/api/user/register
Content-Type: application/json

{
  "userName": "admin",
  "email": "admin@example.com",
  "password": "Admin123!",
  "displayName": "Admin User"
}

###

# List all users (any authenticated user; others' userName/email are masked)
GET {{CMS.Server_HostAddress}}/api/user
Authorization: Bearer {{token}}

###

# Get a user by id
GET {{CMS.Server_HostAddress}}/api/user/{{adminId}}
Authorization: Bearer {{token}}

###

# Update a user (owner or admin only) -> 403 otherwise
PUT {{CMS.Server_HostAddress}}/api/user/{{adminId}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "displayName": "Updated Name"
}

###

# Delete a user (admin only)
DELETE {{CMS.Server_HostAddress}}/api/user/{{adminId}}
Authorization: Bearer {{token}}

###

# Assign a role to a user (admin only)
POST {{CMS.Server_HostAddress}}/api/user/{{adminId}}/roles
Content-Type: application/json
Authorization: Bearer {{token}}

"Admin"

###

# Get a user's roles (any authenticated user)
GET {{CMS.Server_HostAddress}}/api/user/{{adminId}}/roles
Authorization: Bearer {{token}}

###
